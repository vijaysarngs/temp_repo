aegis-cve-evidence/context_gathered/inventory/raw/
aegis-cve-evidence/context_gathered/inventory/disabled/
# Real server context uploaded through the self-service script
aegis-cve-evidence/context_gathered/inventory/uploaded/
# Delivery agent output (committed to the delivery repository instead, AEGIS_DELIVERY_REPO)
aegis-cve-evidence/delivery/artifacts/
# Per-middleware repository settings (names of internal repositories)
aegis-cve-evidence/delivery/middleware_repos.json
# Answers to compatibility questions (facts about real servers)
aegis-cve-evidence/compatibility/answers.json
data/selected_components_ui-*.csv
data/ui-*.csv
tools/callgraph/callgraph.html
.claude/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Stand-alone CVE feed enrichment: cached responses and outputs
cve_feed_enrichment/cache/
cve_feed_enrichment/output/

# Local sign-in database (users, sessions, runs) when AEGIS_AUTH_DB=sqlite
.aegis/
# Context script agent request log and generated scripts (server names, components)
aegis-cve-evidence/context_gathered/script_agent_runs/

# Working data and outputs (kept on disk, never committed): CVE exports, enriched and
# selected-component CSVs, compatibility scope tables, proofs, collector sample outputs.
data/*
!data/.gitkeep
compatibility_scope/
proofs/
docs/
aegis-cve-evidence/context_gathered/script_review/
**/sample_output_*.txt
/classification_diagnostics.json
/deduplicated_cves.csv
*.log
aegis-cve-evidence/testing_evidence_*/
aegis-cve-evidence/Internet_lookup/QUERY_RESEARCH.md
tools/function_sequence/
# Central baseline host context (real server build; optional fallback, AEGIS_CENTRAL_CONTEXT)
aegis-cve-evidence/context_gathered/inventory/central/
# Per-CVE dummy context JSONs (only for run_grouped_remediation --context-dir --allow-dummy)
aegis-cve-evidence/context_gathered/test/
aegis-cve-evidence/context_gathered/product_context.json
# Real server inventory collected from scarck-vprk012 (read by the app; kept local only)
aegis-cve-evidence/context_gathered/inventory/sterling_rocky8.yaml
# Personal batch script (hardcoded CVEs) and the empty root lock file
aegis-cve-evidence/run_all_cves.ps1
/package-lock.json

# Application context uploaded through the self-service script (real servers; recreated on upload)
aegis-cve-evidence/context_gathered/inventory/applications/

# Catch-alls for a fresh deployment: no run data, caches, exports or local databases in git
