# Copy to .env (never commit .env; it is in .gitignore) and fill in the blanks.
# Every value here is a placeholder: no keys, passwords or internal host names.


# --------------------------------------------------------------------------- model provider
# The one switch for every model call: CSV enrichment, remediation agent, Internet lookup
# and the source-adapter fallback. Values: bedrock | azure_openai
LLM_PROVIDER=bedrock
# Optional: model price per million tokens (USD), so the context script agent prints its estimated cost
AEGIS_LLM_PRICE_INPUT_PER_MTOK=
AEGIS_LLM_PRICE_OUTPUT_PER_MTOK=
# Older switch, used only when LLM_PROVIDER is empty: true = bedrock, false = azure_openai
# USE_BEDROCK=true

# --- Amazon Bedrock (LLM_PROVIDER=bedrock) ---
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
# Either access keys...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# ...or a named profile from ~/.aws (leave unset when using keys)
# AWS_PROFILE=
# AWS_DEFAULT_PROFILE=

# --- Azure OpenAI (LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_CHAT_DEPLOYMENT=<your-chat-deployment-name>
# Older name for AZURE_CHAT_DEPLOYMENT (used only when that is empty)
# AZURE_OPENAI_DEPLOYMENT=
# o-series (reasoning) deployments need max_completion_tokens instead of max_tokens.
# AZURE_TOKEN_PARAMETER=max_tokens

# --- Optional model overrides ---
# Smaller Bedrock model ID or Azure deployment for compatibility rule drafting (600 output tokens max).
# AEGIS_COMPAT_RULE_MODEL_ID=
# Compatibility model use (both default on). Off = no model call: users enter rules by hand
# (UI "Enter rule": OS support, requirement, application support, behaviour change) and the
# engine's own checks decide.
# AEGIS_COMPAT_RULE_DRAFTER=off    # no "Draft from a source (model)" option
# AEGIS_COMPAT_JUDGE=off           # no model review of the compatibility checks
# AEGIS_SCRIPT_AGENT_MODEL=off     # context script probes come from the built-in product hints only (no model)
# Central baseline fallback (context_gathered/inventory/central/, kept out of git): a server with no
# context of its own borrows the baseline host facts of its application. Off = such servers are
# marked "context missing" and the card asks for their context.
# AEGIS_CENTRAL_CONTEXT=off
# Internet lookup: by default the provider above (on Bedrock, Haiku for page extraction and
# BEDROCK_MODEL_ID for the rest; on Azure, AZURE_CHAT_DEPLOYMENT for both).
# CVE_FALLBACK_LLM_PROVIDER=
# CVE_FALLBACK_FAST_MODEL=
# CVE_FALLBACK_DEEP_MODEL=
# Only for CVE_FALLBACK_LLM_PROVIDER=anthropic (direct Anthropic API; not Bedrock or Azure)
# ANTHROPIC_API_KEY=
# Source-adapter LLM fallback (used only when a publisher page parser fails): true | false
AEGIS_ADAPTER_LLM_FALLBACK=true
# Model/deployment override for that fallback; blank reuses the configured model.
AEGIS_ADAPTER_FALLBACK_MODEL=

# --------------------------------------------------------------------------- web search
# ddgs (keyless) | duckduckgo | brave (needs BRAVE_API_KEY) | anthropic
CVE_FALLBACK_SEARCH=ddgs
CVE_DDGS_BACKEND=auto
# Comma-separated ddgs backends to try when the first returns nothing
# CVE_DDGS_FALLBACK_BACKENDS=
# BRAVE_API_KEY=
# NVD API key (optional; raises the NVD rate limit from 5 to 50 requests / 30 s).
# Used by the enrichment's NVD fallback (nvd_fallback.py) and cve_feed_enrichment.
NVD_API_KEY=
# Enrichment: look up NVD for CVEs with no description, product, component or application
# (description, CPE product, Oracle component, CVSS, CWE, fixed versions). on | off
# AEGIS_NVD_FALLBACK=on
# Internet lookup: also read pages on websites not on the source list (open web, tier 4)
# when they name the exact CVE; private/internal addresses are never fetched. on | off
# AEGIS_OPEN_WEB=on
# Remediation: when no installed version was collected, assume the highest version the
# evidence names as affected (marked 'assumed, not observed' in the context and UI). on | off
# AEGIS_ASSUME_AFFECTED_VERSION=on

# --------------------------------------------------------------------------- application
PORT=5000
# Minimum spacing between outbound requests in each API worker (seconds)
AEGIS_MODEL_MIN_INTERVAL_SECONDS=2
AEGIS_PAGE_MIN_INTERVAL_SECONDS=0.25
AEGIS_SEARCH_MIN_INTERVAL_SECONDS=2
# Evidence page cache folder and the evidence MCP server's log level
# AEGIS_CACHE_DIR=.cache/aegis-evidence
# AEGIS_LOG_LEVEL=INFO
# 1 = demo mode in the enrichment step
# DEMO_MODE=0

# --------------------------------------------------------------------------- host context
# Host inventory used for remediation context and compatibility. Default (unset): the
# captured Rocky hosts, inventory/aix, inventory/uploaded and the per-server reports in
# inventory/raw. Several paths are separated by ';' on Windows.
# AEGIS_HOST_INVENTORY=
# Per-server gatherer reports (inventory/raw/*.collector.json, newest per server) replace
# the YAML host of the same server. on | off
# AEGIS_RAW_INVENTORY=on
# Rocky Linux host context from Oracle CVE_CONTEXT (gatherer.py --store-db) when the
# Oracle settings below are filled in and reachable; it replaces the report/YAML host of
# the same server (application details still come from that host). auto | off
# AEGIS_INVENTORY_DB=auto
# Tomcat version for every running Tomcat whose version was not collected (the gatherer
# cannot read catalina.jar, so neither the reports nor Oracle have it). A version read
# from a server is kept. A version | off
# AEGIS_TOMCAT_VERSION=9.0.118
# Tomcat CVEs use inventory/synthetic/rocky8_hosts.yaml only while no captured host records
# a Tomcat version (host_inventory.PRODUCT_ROUTES). on | off
# AEGIS_PRODUCT_ROUTES=on
# Compatibility host facts: yaml (the inventory above, plus Oracle CVE_CONTEXT when
# reachable) or oracle (the older HOST_INVENTORY table). Keep yaml.
# AEGIS_COMPAT_CONTEXT_SOURCE=yaml
# The compatibility knowledge base: curated rules and every rule saved from the UI, one
# file kept in git (commit it to share new rules). Default: compatibility/knowledge.yaml
# AEGIS_KNOWLEDGE_FILE=

# --------------------------------------------------------------------------- Oracle
# CVE_CONTEXT (gathered host context, read for Rocky Linux), CVE_RUN / CVE_EVIDENCE /
# CVE_ASSESSMENT (saved runs, only with AEGIS_PERSIST_RUNS=true).
AEGIS_PERSIST_RUNS=false
ORACLE23AI_USER=
ORACLE23AI_PASSWORD=
ORACLE23AI_HOST=<oracle-host>
ORACLE23AI_PORT=1521
ORACLE23AI_SERVICE=<service-name>
# Connection timeout in seconds (the host-context lookup uses 5 when this is unset)
# ORACLE23AI_CONNECT_TIMEOUT=10

# --------------------------------------------------------------------------- delivery agent
# Server deliveries (one version update per product, as a diff folder) are written to
# aegis-cve-evidence/delivery/artifacts. "Commit to git" needs a local clone of the repository
# the artifacts go to; each one is committed on its own branch aegis-delivery/<server>/<id>
# through a temporary worktree, so that clone's checkout is never switched.
# AEGIS_DELIVERY_REPO=C:\path\to\delivery-repo   # unset: download the .zip only
# AEGIS_DELIVERY_PUSH=0                          # 1 = also push the branch
# AEGIS_DELIVERY_REMOTE=origin
# AEGIS_DELIVERY_BASE=HEAD                       # branch/commit the delivery branch starts from
# AEGIS_DELIVERY_PATH=aegis-delivery             # folder inside the repository
# AEGIS_DELIVERY_ARTIFACTS=                      # local artifact folder (default above)

# --------------------------------------------------------------------------- sign-in (aegis_auth)
# Every /api request needs a signed-in user. Create the first admin with
#   python -m aegis_auth create-user you@example.com --role ADMIN   (password is prompted)
# AEGIS_AUTH=on                    # off = no sign-in (tests / single-user local only)
# AEGIS_AUTH_DB=sqlite             # sqlite (.aegis/auth.db) | oracle (uses ORACLE23AI_*)
# AEGIS_AUTH_DB_PATH=.aegis/auth.db
# AEGIS_SESSION_MINUTES=480        # absolute session lifetime
# AEGIS_SESSION_IDLE_MINUTES=60    # idle limit
# AEGIS_COOKIE_SECURE=auto         # on in production (HTTPS)
# AEGIS_TRUST_PROXY=off            # on only behind a trusted reverse proxy (X-Forwarded-For)
