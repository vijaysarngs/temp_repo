# Copy to .env (never commit .env; it is in .gitignore) and fill in the blanks.
# Every value here is a placeholder: no keys, passwords or internal host names.

# --------------------------------------------------------------------------- model provider
# The one switch for every model call: CSV enrichment, remediation agent, Internet lookup
# and the source-adapter fallback. Values: bedrock | azure_openai
LLM_PROVIDER=bedrock

# --- Amazon Bedrock (LLM_PROVIDER=bedrock) ---
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
# Either access keys...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# ...or a named profile from ~/.aws (leave unset when using keys)
# AWS_PROFILE=

# --- Azure OpenAI (LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_CHAT_DEPLOYMENT=<your-chat-deployment-name>
# Optional smaller Bedrock model ID or Azure deployment for compatibility rule drafting
# and on-demand rechecks. Each request is capped at 600 output tokens.
# AEGIS_COMPAT_RULE_MODEL_ID=
# o-series (reasoning) deployments need max_completion_tokens instead of max_tokens.
# AZURE_TOKEN_PARAMETER=max_tokens

# --- Internet lookup model overrides (optional) ---
# By default the lookup uses the provider above: on Bedrock, Haiku for page extraction and
# BEDROCK_MODEL_ID for the rest; on Azure, AZURE_CHAT_DEPLOYMENT for both.
# CVE_FALLBACK_LLM_PROVIDER=
# CVE_FALLBACK_FAST_MODEL=
# CVE_FALLBACK_DEEP_MODEL=

# --- Source-adapter LLM fallback (used only when a publisher parser fails) ---
AEGIS_ADAPTER_LLM_FALLBACK=true
# Model/deployment override; blank reuses the configured model.
AEGIS_ADAPTER_FALLBACK_MODEL=

# --------------------------------------------------------------------------- web search
# ddgs (keyless) | duckduckgo | brave (needs BRAVE_API_KEY) | anthropic (needs
# CVE_FALLBACK_LLM_PROVIDER=anthropic; not available on Bedrock or Azure)
CVE_FALLBACK_SEARCH=ddgs
CVE_DDGS_BACKEND=auto
# BRAVE_API_KEY=
# NVD API key (optional; raises the NVD rate limit)
NVD_API_KEY=

# --------------------------------------------------------------------------- application
PORT=5000
# Minimum spacing between outbound requests in each API worker (seconds)
AEGIS_MODEL_MIN_INTERVAL_SECONDS=2
AEGIS_PAGE_MIN_INTERVAL_SECONDS=0.25
AEGIS_SEARCH_MIN_INTERVAL_SECONDS=2
# Host inventory used for remediation context and compatibility. Default (unset): the
# captured Rocky hosts plus inventory/aix. Several paths are separated by ';' on Windows.
# AEGIS_HOST_INVENTORY=
# Rocky Linux host context from Oracle CVE_CONTEXT (gatherer.py --store-db) when the database
# is reachable; Tomcat and application details still come from the YAML. auto | off
# AEGIS_INVENTORY_DB=auto
# Tomcat CVEs use inventory/synthetic/rocky8_hosts.yaml until the captured hosts record a
# Tomcat version (host_inventory.PRODUCT_ROUTES). on | off
# AEGIS_PRODUCT_ROUTES=on
# Compatibility host facts: yaml (the inventory above) or oracle (HOST_INVENTORY table)
# AEGIS_COMPAT_CONTEXT_SOURCE=yaml

# --------------------------------------------------------------------------- Oracle (optional)
# CVE_CONTEXT (gathered host context), CVE_RUN / CVE_EVIDENCE / CVE_ASSESSMENT (runs),
# HOST_INVENTORY (compatibility). Needed only for --store-db, --persist-context,
# AEGIS_PERSIST_RUNS=true or AEGIS_COMPAT_CONTEXT_SOURCE=oracle.
AEGIS_PERSIST_RUNS=false
ORACLE23AI_USER=
ORACLE23AI_PASSWORD=
ORACLE23AI_HOST=<oracle-host>
ORACLE23AI_PORT=1521
ORACLE23AI_SERVICE=<service-name>
# ORACLE23AI_CONNECT_TIMEOUT=10
